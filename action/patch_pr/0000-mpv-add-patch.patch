From 0000000000000000000000000000000000000003 Mon Sep 17 00:00:00 2001
From: mpv-build <mpv-build@users.noreply.github.com>
Date: Thu, 3 Aug 2023 07:38:57 +0800
Subject: [PATCH] mpv: add patch support for PRs

---
 win/packages/mpv.cmake | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/win/packages/mpv.cmake b/win/packages/mpv.cmake
index 983719f..49dc235 100644
--- a/win/packages/mpv.cmake
+++ b/win/packages/mpv.cmake
@@ -22,7 +22,8 @@ ExternalProject_Add(mpv
         subrandr
     GIT_REPOSITORY https://github.com/mpv-player/mpv.git
     SOURCE_DIR ${SOURCE_LOCATION}
-    GIT_CLONE_FLAGS "--filter=tree:0"
+    GIT_CLONE_FLAGS ""
+    PATCH_COMMAND ${EXEC} git am --3way ${CMAKE_CURRENT_SOURCE_DIR}/mpv-*.patch
     UPDATE_COMMAND ""
     CONFIGURE_COMMAND ${EXEC} CONF=1 meson setup <BINARY_DIR> <SOURCE_DIR>
         --prefix=${MINGW_INSTALL_PREFIX}
-- 
2.52.0
