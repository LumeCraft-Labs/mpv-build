From 0000000000000000000000000000000000000012 Mon Sep 17 00:00:00 2001
From: mpv-build <mpv-build@users.noreply.github.com>
Date: Sat, 10 May 2025 23:11:21 +0800
Subject: [PATCH] ffmpeg: use librempeg fork

---
 win/packages/ffmpeg.cmake | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/win/packages/ffmpeg.cmake b/win/packages/ffmpeg.cmake
--- a/win/packages/ffmpeg.cmake
+++ b/win/packages/ffmpeg.cmake
@@ -35,7 +35,7 @@ ExternalProject_Add(ffmpeg
         rubberband
         libva
-    GIT_REPOSITORY https://github.com/FFmpeg/FFmpeg.git
+    GIT_REPOSITORY https://github.com/librempeg/librempeg.git
     SOURCE_DIR ${SOURCE_LOCATION}
     GIT_CLONE_FLAGS "--sparse --filter=tree:0"
     GIT_CLONE_POST_COMMAND "sparse-checkout set --no-cone /* !tests/ref/fate"
-- 
